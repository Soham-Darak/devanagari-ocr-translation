
APP_NAME=Lekha API
APP_ENV=development
API_PREFIX=/api

FRONTEND_ORIGIN=http://localhost:5173

MODEL_CHECKPOINT=./models/devanagari_cnn_best.pth
MODEL_DEVICE=auto

TRANSLATION_MODEL_NAME=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=cpu

MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=20
PDF_RENDER_DPI=180
MAX_TRANSLATION_CHARACTERS=30000
